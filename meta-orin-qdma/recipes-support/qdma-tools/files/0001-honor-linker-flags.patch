From: Orin QDMA development <local@example.invalid>
Subject: [PATCH] apps: honor cross-linker flags and document nanosecond timing

Keep target sysroot and Yocto QA linker flags in every executable.

Upstream-Status: Pending

diff --git a/QDMA/linux-kernel/apps/dma-ctl/Makefile b/QDMA/linux-kernel/apps/dma-ctl/Makefile
index 1ac7a76..c2b2eb7 100755
--- a/QDMA/linux-kernel/apps/dma-ctl/Makefile
+++ b/QDMA/linux-kernel/apps/dma-ctl/Makefile
@@ -29,7 +29,7 @@ endif
 all: clean dma-ctl
 
 dma-ctl: $(DMA-CTL_OBJS)
-	$(CC) -pthread -lrt $^ -o $(DMA-CTL) -laio -D_FILE_OFFSET_BITS=64 -D_GNU_SOURCE -D_LARGE_FILE_SOURCE
+	$(CC) $(LDFLAGS) -pthread -lrt $^ -o $(DMA-CTL) -laio -D_FILE_OFFSET_BITS=64 -D_GNU_SOURCE -D_LARGE_FILE_SOURCE
 	
 %.o: %.c
 	$(CC) $(CFLAGS) -c -std=c99 -o $@ $< -D_FILE_OFFSET_BITS=64 -D_GNU_SOURCE -D_LARGE_FILE_SOURCE -D_AIO_AIX_SOURCE
